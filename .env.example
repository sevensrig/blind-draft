# Remote play (Tier 2). Leave blank to run local-only: the app hides the online
# entry point when these are missing.
#
# NOTE: these need the PUBLIC_ prefix even though the Supabase/Vercel integration
# syncs SUPABASE_URL and SUPABASE_ANON_KEY without it. SvelteKit only exposes
# PUBLIC_-prefixed variables to the browser, and that guard is what stops
# SUPABASE_SERVICE_ROLE_KEY ever reaching a client bundle. So these two are
# deliberately separate from the auto-synced pair.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Product analytics (PostHog) and error tracking (Sentry). Leave blank and both
# stay off, which is how tests and local dev run. Both load lazily, so an unset
# key ships none of the SDK.
PUBLIC_POSTHOG_KEY=
# Optional: defaults to https://us.i.posthog.com. Use https://eu.i.posthog.com for an EU project.
PUBLIC_POSTHOG_HOST=
PUBLIC_SENTRY_DSN=
# Optional: defaults to production. Set to "preview" on Vercel previews.
PUBLIC_SENTRY_ENVIRONMENT=

# Build-time only (never PUBLIC_): uploads hidden source maps to Sentry so stack
# traces are readable. Without SENTRY_AUTH_TOKEN the build skips the upload.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
