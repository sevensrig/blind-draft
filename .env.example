# Remote play (Tier 2). Leave blank to run local-only: the app hides the online
# entry point when these are missing.
#
# NOTE: these need the PUBLIC_ prefix even though the Supabase/Vercel integration
# syncs SUPABASE_URL and SUPABASE_ANON_KEY without it. SvelteKit only exposes
# PUBLIC_-prefixed variables to the browser, and that guard is what stops
# SUPABASE_SERVICE_ROLE_KEY ever reaching a client bundle. So these two are
# deliberately separate from the auto-synced pair.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
