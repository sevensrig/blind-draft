{
	"name": "blind-draft",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "npm run typecheck && npm run lint && npm run test",
		"test": "npm run test:unit && npm run test:component && npm run test:e2e",
		"typecheck": "svelte-kit sync && tsc --noEmit && svelte-check --tsconfig ./tsconfig.json",
		"lint": "biome lint .",
		"format": "biome format --write . && prettier --write .",
		"format:check": "biome format . && prettier --check .",
		"test:unit": "vitest run --project unit",
		"test:component": "vitest run --project component",
		"test:e2e": "playwright test",
		"test:a11y": "vitest run --project component src/lib/components/a11y.component.test.ts && playwright test e2e/a11y.spec.ts",
		"coverage": "vitest run --project unit --coverage"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@biomejs/biome": "^2.5.6",
		"@playwright/test": "^1.62.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@vitest/browser": "^4.1.10",
		"@vitest/browser-playwright": "^4.1.10",
		"@vitest/coverage-v8": "^4.1.10",
		"axe-core": "^4.12.1",
		"playwright": "^1.62.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.10",
		"vitest-browser-svelte": "^3.0.0"
	}
}
