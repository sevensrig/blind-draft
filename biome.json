{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"src/**/*.ts",
			"src/**/*.js",
			"e2e/**/*.ts",
			"*.ts",
			"*.js",
			"*.json",
			"!**/node_modules",
			"!.svelte-kit",
			"!build",
			"!coverage",
			"!playwright-report",
			"!test-results",
			"!src/lib/icons.ts",
			"!package-lock.json",
			"!**/*.svelte"
		]
	},
	"formatter": {
		"enabled": true,
		"useEditorconfig": false,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100,
		"lineEnding": "lf"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"trailingCommas": "none",
			"semicolons": "always",
			"arrowParentheses": "always"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"preset": "recommended",
				"useConst": "error",
				"noNonNullAssertion": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.test.ts", "e2e/**/*.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						"noExplicitAny": "off"
					}
				}
			}
		}
	]
}
